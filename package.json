{
  "name": "horizon-nav",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "go run . -config config.yaml",
    "test": "go test ./... && node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "format": "prettier --write src vite.config.ts scripts/dev.mjs",
    "test:race": "go test -race ./...",
    "package": "python3 scripts/package.py"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-rotate": "^0.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.18",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
